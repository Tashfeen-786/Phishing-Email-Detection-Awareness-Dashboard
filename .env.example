# ===========================================================================
# Phishing Email Detection & Awareness Dashboard - configuration
#
# Copy this file to ".env" and edit if you want to change anything.
# setup_windows.bat does the copy for you.
#
# EVERY setting below has a working default. You can delete this whole file
# and the project still runs.
#
# NEVER commit your real .env to Git. .gitignore already excludes it.
# ===========================================================================

# ---- Application -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---- Paths (relative to the project root) ------------------------------
# DATABASE_PATH=data/phishing_analysis.db
# DATASET_PATH=data/phishing_email_dataset.csv
# MODEL_PATH=models/phishing_model.joblib

# ---- Hybrid scoring ----------------------------------------------------
# How much the transparent rule engine counts versus the ML model.
# These two must add up to 1.0. Rules are weighted higher on purpose:
# they can explain themselves to an analyst, and a probability cannot.
HYBRID_RULE_WEIGHT=0.6
HYBRID_ML_WEIGHT=0.4

# ---- Privacy -----------------------------------------------------------
# When false (the default) the full email body is NEVER written to the
# database - only the derived indicators are kept. Turn it on only if you
# genuinely need the text, and only on synthetic data.
STORE_EMAIL_BODY=false

# ---- Optional authentication -------------------------------------------
# Authentication is OFF by default so the dashboard "just works" locally.
# Set REQUIRE_AUTH=true to protect DELETE /api/analyses/{id}.
REQUIRE_AUTH=false

# If you enable auth, set a long random secret here. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving it empty makes the app generate a random secret at each startup,
# which is safe but logs everyone out whenever the server restarts.
SECRET_KEY=

TOKEN_TTL_SECONDS=3600

# ---- Rate limiting -----------------------------------------------------
RATE_LIMIT_CALLS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- CORS --------------------------------------------------------------
# The Vite dev server proxies /api, so the browser and the API share an
# origin and CORS is not normally needed. This is here for the case where
# you serve the built frontend from somewhere else.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
