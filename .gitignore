# ===========================================================================
# Phishing Email Detection & Awareness Dashboard
#
# The two rules that matter most:
#   1. never commit secrets (.env)
#   2. never commit anything a reader can regenerate (.venv, node_modules)
# ===========================================================================

# ---- Secrets -----------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets.json
credentials.json

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ---- Node / frontend ---------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Generated at runtime ----------------------------------------------
# The database is local state, not source. Recreate it with seed_demo.bat.
data/*.db
data/*.db-wal
data/*.db-shm
logs/*.log

# The trained model is a build artefact (~100 KB here, but it is still
# generated). Recreate it with train_model.bat.
models/*.joblib
models/distilbert/

# ---- Editors / OS ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ===========================================================================
# DELIBERATELY COMMITTED (do not add these to the list above):
#
#   data/phishing_email_dataset.csv  - fully synthetic, and committing it
#                                      makes the results reproducible
#   reports/                         - real measured metrics
#   screenshots/                     - the evidence pack
#   docs/                            - the written report
# ===========================================================================
